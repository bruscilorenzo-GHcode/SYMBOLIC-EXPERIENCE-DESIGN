      "@aura-spec/catalog": ["packages/catalog/src/index.ts"],
      "@aura-spec/osc-bridge": ["packages/osc-bridge/src/index.ts"],
      "@aura-spec/landscape-culture": ["packages/landscape-culture/src/index.ts"],
      "@aura-spec/inhabiting-model": ["packages/inhabiting-model/src/index.ts"],
      "@aura-spec/design-bridge": ["packages/design-bridge/src/index.ts"],
