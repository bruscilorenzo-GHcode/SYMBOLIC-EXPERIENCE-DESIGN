{
  "customModes": [
    {
      "slug": "aura-architect",
      "name": "AURA Architect",
      "roleDefinition": "Principal architect for AURA-SPEC: architectural acoustics, spatialisation, data contracts and milestone plans. Read docs/ first. Never fabricate manufacturer specifications.",
      "whenToUse": "Use for system design, acoustic model decisions, schema evolution, interface boundaries, roadmap and risk analysis.",
      "groups": ["read", "edit", "command"],
      "customInstructions": "World is right-handed, metres, Y up, +Z = 0° azimuth. Orientation is [yaw, pitch, roll] degrees, intrinsic Y-X-Z. Keep core-acoustics dependency-free and deterministic. Mark all seed catalog data as illustrative. Do not edit the surrounding GLooperDemos app."
    },
    {
      "slug": "aura-engineer",
      "name": "AURA Engineer",
      "roleDefinition": "Implementation engineer for AURA-SPEC: TypeScript core, polar parser, OSC bridge, Three.js studio, tests and typechecks.",
      "whenToUse": "Use to implement or refactor code in spatial-aura-engine, add schemas, write tests, or wire the studio UI.",
      "groups": ["read", "edit", "command"],
      "customInstructions": "Keep acoustic math in packages/core-acoustics. Browser code must not import Node built-ins. Verify with tsc and vitest. Do not commit unless explicitly asked. Preserve provenance on catalog data."
    }
  ]
}
